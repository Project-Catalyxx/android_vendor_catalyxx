<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.catalyxx.overlay.lineagesdk">

    <!-- Priority 10 so these win over the priority-1 auto-generated RROs
         that LineageOS ships for the same targets. -->
    <overlay
        android:targetPackage="lineageos.platform"
        android:isStatic="true"
        android:priority="10" />
</manifest>
