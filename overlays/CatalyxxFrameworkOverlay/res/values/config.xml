<resources>
    <!-- First-boot Monet defaults, read by SystemUI's ThemeOverlayController while
         setup is still running. Pins the Catalyxx lavender (HCT hue 299) as a preset
         seed, so the system palette stays lavender whatever wallpaper is set, until
         the user picks other colors in Wallpaper & style. Replaces LineageOS's
         *|TONAL_SPOT|#0049c7.

         RAINBOW: primary at chroma 48 with grey neutrals, the style the palette was
         chosen against. -->
    <string-array name="theming_defaults" translatable="false">
        <item>*|RAINBOW|#874EFF</item>
    </string-array>

    <!-- Keyboard vibration follows touch feedback's intensity, so the one Touch
         slider sets taps and typing. Pixel's framework overlay turns separate
         keyboard settings on, but only as an on/off switch at a fixed default
         intensity, which no slider reaches. Keypress vibration can still be
         turned off in the keyboard app. -->
    <bool name="config_keyboardVibrationSettingsSupported">false</bool>

    <!-- Start in 3-button navigation, with GApps too. Pixel's framework overlay
         (pixel-style PixelConfigOverlay2019, priority 6) turns on gestural
         navigation hints, meant for devices that default to gestures: Pixel
         setup's gestural page (com.google.android.pixel.setupwizard
         GesturalNavWrapper) then picks gesture navigation, applied when setup
         finishes. Gestures stay a tap away in Settings > System > Navigation
         mode. -->
    <bool name="config_showGesturalNavigationHints">false</bool>
</resources>
