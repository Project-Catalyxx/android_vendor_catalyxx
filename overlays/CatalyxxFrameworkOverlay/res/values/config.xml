<resources>
    <!-- First-boot Monet defaults, read by SystemUI's ThemeOverlayController while
         setup is still running. Pins the Catalyxx lavender (HCT hue 299) as a preset
         seed, so the system palette stays lavender whatever wallpaper is set, until
         the user picks other colors in Wallpaper & style. Replaces LineageOS's
         *|TONAL_SPOT|#0049c7.

         RAINBOW: primary at chroma 48 with grey neutrals, the style the palette was
         chosen against. -->
    <string-array name="theming_defaults" translatable="false">
        <item>*|RAINBOW|#874EFF</item>
    </string-array>
</resources>
