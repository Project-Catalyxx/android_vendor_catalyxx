<resources>
    <!-- Volume slider gradient, on by default in custom mode: lavender tone 80, the
         dark-theme primary of the system palette, deepening into the Catalyxx
         signature violet as the volume rises. SystemUI stretches the gradient over
         the whole track with start at the quiet end and end at the loud end, so the
         violet goes in end. Needs the def_* loader in SettingsProvider's
         DatabaseHelper. -->
    <bool name="def_volume_slider_gradient">true</bool>
    <integer name="def_custom_gradient_color_mode">1</integer>
    <color name="def_custom_gradient_start_color">#FFCFBAFF</color>
    <color name="def_custom_gradient_end_color">#FFA100F1</color>

    <!-- The media volume in percent under the volume dialog's slider. Needs the
         def_show_volume_percentage loader in SettingsProvider's DatabaseHelper. -->
    <bool name="def_show_volume_percentage">true</bool>
</resources>
