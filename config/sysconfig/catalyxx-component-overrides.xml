<config>
    <!-- LineageOS Trust is not shipped (vendor/lineage no longer declares
         org.lineageos.trust), so hide the empty page LineageParts would
         still inject into Settings > Privacy. -->
    <component-override package="org.lineageos.lineageparts">
        <component class=".trust.TrustPreferences" enabled="false" />
    </component-override>

    <!-- LineageOS's setup wizard (builds without GApps) skips a page whose activity is
         disabled. Skip its "LineageOS features" page: its "Help improve" switch, on by
         default, sends usage stats to stats.lineageos.org, and its text points to
         LineageOS's privacy policy. Skipped, the stats setting keeps its default,
         which CatalyxxLineageSettingsProviderOverlay turns off. -->
    <component-override package="org.lineageos.setupwizard">
        <component class=".settings.LineageSettingsActivity" enabled="false" />
    </component-override>
</config>
