<config>
    <!-- LineageOS Trust is not shipped (vendor/lineage no longer declares
         org.lineageos.trust), so hide the empty page LineageParts would
         still inject into Settings > Privacy. -->
    <component-override package="org.lineageos.lineageparts">
        <component class=".trust.TrustPreferences" enabled="false" />
        <!-- LineageOS statistics: no reports to stats.lineageos.org from Catalyxx (a
             device hash, the model, the Catalyxx version, country and carrier), even
             when the "Stats collection" switch is on. Off by default as well
             (CatalyxxLineageSettingsProviderOverlay), but on salami it turned itself
             back on once, cause unknown. These start the report at boot, build it and
             upload it. -->
        <component class=".lineagestats.ReportingServiceManager" enabled="false" />
        <component class=".lineagestats.ReportingService" enabled="false" />
        <component class=".lineagestats.StatsUploadJobService" enabled="false" />
    </component-override>

    <!-- LineageOS's setup wizard (builds without GApps) skips a page whose activity is
         disabled. Skip its "LineageOS features" page: its "Help improve" switch, on by
         default, sends usage stats to stats.lineageos.org, and its text points to
         LineageOS's privacy policy. Skipped, the stats setting keeps its default,
         which CatalyxxLineageSettingsProviderOverlay turns off. -->
    <component-override package="org.lineageos.setupwizard">
        <component class=".settings.LineageSettingsActivity" enabled="false" />
    </component-override>

    <!-- Pixel setup (builds with GApps) skips a step whose activity is disabled. Skip its
         gestural navigation page: when no old phone was copied (source device manufacturer
         empty) it sets long press power to Gemini (power_button_long_press 5) instead of
         the power menu (config_longPressOnPowerBehavior 1), and it records a navigation
         mode that setup applies when it finishes. Its gestural hints are off anyway
         (CatalyxxFrameworkOverlay), so the page shows nothing. -->
    <component-override package="com.google.android.pixel.setupwizard">
        <component class=".user.GesturalNavWrapper" enabled="false" />
    </component-override>
</config>
